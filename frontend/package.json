{
  "name": "metis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "types": "npx openapi-typescript ../backend/openapi.json -o ./src/types_api.ts --properties-required-by-default",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.1.0",
    "@fontsource/source-code-pro": "^5.2.6",
    "@fontsource/source-sans-pro": "^5.1.0",
    "@vueuse/core": "^13.0.0",
    "accessible-colors": "^1.0.0",
    "dotenv": "^16.4.0",
    "openapi-fetch": "^0.14.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-markdown-render": "^2.2.0",
    "vue-router": "^4.5.0",
    "vuetify": "^3.8.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.0",
    "@mdi/font": "^7.4.47",
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^24.0.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/eslint-plugin": "^1.1.0",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.7.0",
    "cypress": "^14.4.0",
    "eslint": "^9.22.0",
    "eslint-plugin-cypress": "^4.2.0",
    "eslint-plugin-vue": "^10.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.0",
    "jsdom": "^25.0.0",
    "npm-run-all2": "^7.0.0",
    "openapi-typescript": "^7.5.0",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.0",
    "start-server-and-test": "^2.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-vuetify": "^2.0.0",
    "vitest": "^3.1.1",
    "vue-tsc": "^3.0.0"
  }
}
